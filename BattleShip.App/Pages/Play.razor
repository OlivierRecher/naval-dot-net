@page "/"
@using BattleShip.App.Services
@using BattleShip.Models
@implements IDisposable
@inject GameSession Session
@inject OceanAudio Audio

<PageTitle>Bataille navale</PageTitle>

<header class="hero">
    <h1>Bataille navale</h1>
    <p class="tagline">Sondez les fonds, repérez la flotte adverse — et coulez-la avant qu'elle ne vous trouve.</p>
</header>

@if (Session.Failure is not null)
{
    <div class="alert alert-danger" role="alert">
        @Session.Failure
        @if (Session.CanRetryBotTurn)
        {
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RetryBotTurnAsync">Relancer le tour du bot</button>
        }
    </div>
}

@if (Session.View is null)
{
    <div class="card p-4 setup">
        <h2 class="h5">Nouvelle partie</h2>

        <label class="form-label" for="mode">Adversaire</label>
        <select id="mode" class="form-select mb-3" @bind="_mode">
            <option value="@GameModeNames.Solo">Un bot</option>
            <option value="@GameModeNames.Local">Un second joueur, sur cet appareil</option>
        </select>

        <label class="form-label" for="player">Votre nom</label>
        <input id="player" class="form-control mb-3" @bind="_playerName" />

        @if (_mode == GameModeNames.Local)
        {
            <label class="form-label" for="opponent">Nom du second joueur</label>
            <input id="opponent" class="form-control mb-3" @bind="_opponentName" />
        }

        <label class="form-label" for="side">Taille de la grille</label>
        <input id="side" type="number" min="@BoardBounds.MinSide" max="@BoardBounds.MaxSide"
               class="form-control" @bind="_side" />
        @if (SideProblem is { } sideProblem)
        {
            <p class="form-text text-danger">@sideProblem</p>
        }
        <div class="mb-3"></div>

        @if (_mode == GameModeNames.Solo)
        {
        <label class="form-label" for="difficulty">Difficulté du bot</label>
        <select id="difficulty" class="form-select" @bind="_botDifficulty">
            @foreach (var option in BotDifficultyCatalog.All)
            {
                <option value="@option.Name">@option.Label</option>
            }
        </select>
        <p class="form-text mb-3">@BotDifficultyCatalog.SummaryOf(_botDifficulty)</p>
        }

        <label class="form-label">Composition de la flotte</label>
        <ul class="fleet fleet-picker mb-1">
            @foreach (var ship in ShipCatalog.All)
            {
                <li>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            aria-label="Retirer un @ship.Label"
                            disabled="@(_fleet.GetValueOrDefault(ship.Name) is 0)"
                            @onclick="() => Adjust(ship.Name, -1)">−</button>
                    <span class="badge text-bg-light">@_fleet.GetValueOrDefault(ship.Name)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            aria-label="Ajouter un @ship.Label"
                            @onclick="() => Adjust(ship.Name, 1)">+</button>
                    <span class="hull">@ship.Label</span>
                    <span class="pips" aria-hidden="true">
                        @for (var pip = 0; pip < ship.Size; pip++)
                        {
                            <span class="pip"></span>
                        }
                    </span>
                    <span class="count">@ship.Size case@(ship.Size > 1 ? "s" : "")</span>
                </li>
            }
        </ul>
        <p class="form-text mb-1">
            @FleetShipCount navire@(FleetShipCount > 1 ? "s" : ""), @FleetCellCount case@(FleetCellCount > 1 ? "s" : "")
            sur @(_side * _side) — @((100.0 * FleetCellCount / (_side * _side)).ToString("F0")) % de la grille.
        </p>
        @if (FleetProblem is { } problem)
        {
            <p class="form-text text-danger">@problem</p>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary mb-3 align-self-start" @onclick="ResetFleet">
            Revenir à la flotte classique
        </button>

        <label class="form-label" for="placement">Placement de votre flotte</label>
        <select id="placement" class="form-select mb-3" @bind="_fleetPlacement">
            <option value="Random">Aléatoire — le serveur pose la flotte</option>
            <option value="Manual">Manuel — vous posez chaque navire</option>
        </select>

        <button class="btn btn-primary btn-lg dive" @onclick="StartAsync" disabled="@(Session.IsBusy || SetupProblem is not null)">
            @(Session.IsBusy ? "Immersion…" : "Larguer les amarres")
        </button>
    </div>
}
else if (Session.IsAwaitingHandover)
{
    <div class="card p-4 setup handover text-center">
        <svg class="periscope" viewBox="0 0 80 80" aria-hidden="true">
            <circle class="lens" cx="40" cy="40" r="30" />
            <path class="reticle" d="M40 14v52M14 40h52" />
            <circle class="iris" cx="40" cy="40" r="11" />
        </svg>

        <h2 class="h4">Passez l'appareil</h2>
        <p class="lead mb-1">Au tour de <strong>@Session.HandoverTo</strong>.</p>
        @if (Session.Notice is not null)
        {
            <p class="text-muted">@Session.Notice</p>
        }
        <p class="form-text">
            Rien n'est affiché tant que vous n'avez pas confirmé : l'écran suivant montre
            la flotte de @Session.HandoverTo.
        </p>
        @if (Session.IsHandoverReady)
        {
            <button class="btn btn-primary mt-2" @onclick="ConfirmHandover">
                Je suis @Session.HandoverTo, afficher mon tour
            </button>
        }
        else
        {
            <p class="text-danger">L'état de la partie n'a pas pu être récupéré ; rien ne peut être affiché sans lui.</p>
            <button class="btn btn-outline-danger mt-2" disabled="@Session.IsBusy" @onclick="RetryHandoverAsync">
                @(Session.IsBusy ? "Récupération…" : "Réessayer")
            </button>
        }
    </div>
}
else if (Session.IsPlacingFleet)
{
    <div class="status alert alert-secondary" role="status">
        <strong>Posez votre flotte.</strong>
        <span> @_placed.Count / @Session.View.FleetToPlace.Count navires placés.</span>
        @if (Session.Notice is not null)
        {
            <span> @Session.Notice</span>
        }
    </div>

    <div class="boards">
        <section class="board">
            <h2 class="h6">Votre grille</h2>
            <div class="grid" style="--columns: @Session.View.Columns" @onmouseleave="ClearHover">
                <span class="axis corner" aria-hidden="true"></span>
                @for (var column = 0; column < Session.View.Columns; column++)
                {
                    <span class="axis" aria-hidden="true">@((char)('A' + column))</span>
                }

                @for (var row = 0; row < Session.View.Rows; row++)
                {
                    <span class="axis" aria-hidden="true">@(row + 1)</span>

                    for (var column = 0; column < Session.View.Columns; column++)
                    {
                        // `column` et `row` sont les variables de la boucle for : les
                        // capturer dans le lambda les ferait toutes valoir leur valeur
                        // finale. La copie locale est ce qui lie chaque bouton a sa case.
                        var cell = new CoordinatesDto(column, row);

                        <button type="button"
                                class="cell @(_takenCells.Contains(cell) ? "cell-ship" : "cell-empty") @PreviewClass(cell)"
                                disabled="@(Session.IsBusy || NextShip is null)"
                                title="@PlacementCellLabel(cell)"
                                aria-label="@PlacementCellLabel(cell)"
                                @onmouseover="() => Hover(cell)"
                                @onclick="() => PlaceAt(cell)">
                        </button>
                    }
                }
            </div>
        </section>

        <section class="board">
            <h2 class="h6">Flotte à poser</h2>

            @if (NextShip is { } next)
            {
                <p class="current">
                    Navire courant : <strong>@ShipCatalog.LabelOf(next.Kind)</strong>
                    <span class="pips" aria-hidden="true">
                        @for (var pip = 0; pip < next.Size; pip++)
                        {
                            <span class="pip"></span>
                        }
                    </span>
                    — @next.Size case@(next.Size > 1 ? "s" : "").
                </p>

                <div class="btn-group mb-3" role="group">
                    <button type="button"
                            class="btn btn-sm @(_orientation == OrientationNames.Horizontal ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => Turn(OrientationNames.Horizontal)">Horizontal</button>
                    <button type="button"
                            class="btn btn-sm @(_orientation == OrientationNames.Vertical ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => Turn(OrientationNames.Vertical)">Vertical</button>
                </div>

                <p class="form-text">Cliquez la case de départ : elle sera l'extrémité haute ou gauche du navire.</p>
            }
            else
            {
                <p class="current">Tous les navires sont posés.</p>
            }

            <ul class="fleet">
                @foreach (var ship in Session.View.FleetToPlace.Select((ship, index) => (ship, index)))
                {
                    <li class="@(ship.index < _placed.Count ? "done" : null)">
                        <span class="hull">@ShipCatalog.LabelOf(ship.ship.Kind)</span>
                        <span class="pips" aria-hidden="true">
                            @for (var pip = 0; pip < ship.ship.Size; pip++)
                            {
                                <span class="pip @(ship.index < _placed.Count ? "pip-set" : null)"></span>
                            }
                        </span>
                        <span class="count">@ship.ship.Size case@(ship.ship.Size > 1 ? "s" : "")</span>
                    </li>
                }
            </ul>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary"
                        disabled="@(NextShip is not null || Session.IsBusy)"
                        @onclick="ConfirmFleetAsync">
                    @(Session.IsBusy ? "Envoi…" : "Valider la flotte")
                </button>
                <button class="btn btn-outline-secondary" disabled="@(_placed.Count is 0)" @onclick="UndoLastShip">
                    Retirer le dernier
                </button>
                <button class="btn btn-outline-secondary" disabled="@(_placed.Count is 0)" @onclick="ClearFleet">
                    Tout effacer
                </button>
            </div>
        </section>
    </div>

    <button class="btn btn-outline-secondary mt-3" @onclick="Reset">Abandonner cette partie</button>
}
else
{
    <div class="status alert @(Session.IsOver ? "alert-success" : "alert-secondary") @(Session.IsOver ? "finale" : null)" role="status">
        @if (Session.IsOver)
        {
            <span class="flag" aria-hidden="true">@(Session.View.Winner == Session.View.ViewerName ? "🏆" : "🌊")</span>
            <strong>Partie terminée — @(Session.View.Winner) l'emporte.</strong>
        }
        else
        {
            <span class="sonar @(Session.View.IsViewerTurn ? "ready" : "waiting")" aria-hidden="true"></span>
            <strong>@(Session.View.IsViewerTurn ? $"Au tour de {Session.View.ViewerName}." : "Le bot joue…")</strong>
            @if (!Session.IsHotSeat)
            {
                <span class="badge text-bg-dark ms-1">@BotDifficultyCatalog.LabelOf(Session.View.BotDifficulty)</span>
            }
        }
        @if (Session.Notice is not null)
        {
            <span> @Session.Notice</span>
        }
    </div>

    <div class="boards">
        <section class="board">
            <h2 class="h6">Grille adverse</h2>
            <div class="grid hunting" style="--columns: @Session.View.Columns">
                <span class="axis corner" aria-hidden="true"></span>
                @for (var column = 0; column < Session.View.Columns; column++)
                {
                    <span class="axis" aria-hidden="true">@((char)('A' + column))</span>
                }

                @for (var row = 0; row < Session.View.Rows; row++)
                {
                    <span class="axis" aria-hidden="true">@(row + 1)</span>

                    for (var column = 0; column < Session.View.Columns; column++)
                    {
                        var target = new CoordinatesDto(column, row);
                        var known = _fired.GetValueOrDefault(target);

                        <button type="button"
                                class="cell @EnemyCellClass(known) @(_justRevealed.Contains(target) ? "cell-fresh" : null)"
                                disabled="@(!Session.CanFire || known is not null)"
                                title="@EnemyCellLabel(target, known)"
                                aria-label="@EnemyCellLabel(target, known)"
                                @onclick="() => FireAsync(target)">
                        </button>
                    }
                }
            </div>
        </section>

        <section class="board">
            <h2 class="h6">Votre flotte</h2>
            <div class="grid" style="--columns: @Session.View.Columns">
                <span class="axis corner" aria-hidden="true"></span>
                @for (var column = 0; column < Session.View.Columns; column++)
                {
                    <span class="axis" aria-hidden="true">@((char)('A' + column))</span>
                }

                @for (var row = 0; row < Session.View.Rows; row++)
                {
                    <span class="axis" aria-hidden="true">@(row + 1)</span>

                    for (var column = 0; column < Session.View.Columns; column++)
                    {
                        var cell = new CoordinatesDto(column, row);
                        <div class="cell @OwnCellClass(cell) @(_justStruck.Contains(cell) ? "cell-fresh" : null)"
                             title="@OwnCellLabel(cell)"
                             role="img"
                             aria-label="@OwnCellLabel(cell)"></div>
                    }
                }
            </div>

            <ul class="fleet">
                @foreach (var ship in Session.View.OwnFleet)
                {
                    <li class="@(ship.IsSunk ? "sunk" : null)">
                        <span class="hull">@ShipCatalog.LabelOf(ship.Kind)</span>
                        <span class="pips" aria-hidden="true">
                            @for (var pip = 0; pip < ship.Cells.Count; pip++)
                            {
                                <span class="pip @(pip < ship.Hits.Count ? "pip-hit" : null)"></span>
                            }
                        </span>
                        <span class="count">@ship.Hits.Count / @ship.Cells.Count</span>
                    </li>
                }
            </ul>
        </section>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <button class="btn btn-outline-secondary" @onclick="Reset">Nouvelle partie</button>
        @* CanFire, et pas seulement « un tir a été joué » : hors tour ou partie
           terminée, le serveur refuserait avant même de regarder la case, et la
           démonstration montrerait NotTheClientTurn ou GameFinished au lieu du
           AlreadyTargeted annoncé. *@
        <button class="btn btn-outline-info"
                disabled="@(!Session.CanFire || Session.View.ShotsFired.Count is 0)"
                @onclick="DemonstrateGrpcRefusalAsync">
            Démontrer l'erreur gRPC-Web
        </button>
    </div>

    @if (Session.GrpcRefusal is not null)
    {
        <div class="alert alert-info mt-2" role="status">
            @Session.GrpcRefusal
        </div>
    }
    else if (Session.View.ShotsFired.Count is 0)
    {
        <p class="form-text hint">Tirez une fois pour pouvoir rejouer ce tir et voir le refus du serveur.</p>
    }
}

@code {
    private string _playerName = "Joueur";
    private int _side = 10;
    private string _botDifficulty = BotDifficultyCatalog.All[0].Name;
    private string _fleetPlacement = "Random";
    private string _mode = GameModeNames.Solo;
    private string _opponentName = "Ulysse";
    private Dictionary<string, int> _fleet = ClassicFleet();

    private static Dictionary<string, int> ClassicFleet() =>
        ShipCatalog.All.ToDictionary(
            ship => ship.Name,
            ship => ShipCatalog.Classic.Count(name => name == ship.Name));

    private int FleetShipCount => _fleet.Values.Sum();

    private int FleetCellCount =>
        _fleet.Sum(entry => entry.Value * ShipCatalog.All.First(ship => ship.Name == entry.Key).Size);

    /// <summary>
    /// <c>min</c> et <c>max</c> d'un <c>input type="number"</c> n'empêchent ni la
    /// saisie ni le collage d'une valeur hors bornes, et il n'y a pas de
    /// <c>form</c> : sans ce contrôle, le bouton reste actif et le joueur
    /// n'apprend la borne qu'au refus du serveur.
    /// </summary>
    private string? SideProblem => _side < BoardBounds.MinSide || _side > BoardBounds.MaxSide
        ? $"La grille va de {BoardBounds.MinSide} à {BoardBounds.MaxSide} cases de côté."
        : null;

    private string? SetupProblem => SideProblem ?? FleetProblem;

    /// <summary>
    /// Les mêmes bornes que le serveur, pour dire tout de suite ce qu'il
    /// refuserait. C'est un confort : la garantie reste le refus du serveur.
    /// </summary>
    private string? FleetProblem => FleetShipCount switch
    {
        0 => "Il faut au moins un navire.",
        > 15 => "Quinze navires au maximum.",
        _ when _fleet.Any(entry => entry.Value > 0
                && ShipCatalog.All.First(ship => ship.Name == entry.Key).Size > _side)
            => "Un navire est plus long que la grille.",
        _ when FleetCellCount > _side * _side / 3.0
            => "Cette flotte remplit plus du tiers de la grille : le placement aléatoire ne tiendrait pas.",
        _ => null
    };

    private void Adjust(string kind, int delta)
    {
        _fleet[kind] = Math.Max(0, _fleet.GetValueOrDefault(kind) + delta);
        Audio.Play("tap");
    }

    private void ResetFleet()
    {
        _fleet = ClassicFleet();
        Audio.Play("tap");
    }

    private List<string> FleetAsNames() =>
        [.. _fleet.SelectMany(entry => Enumerable.Repeat(entry.Key, entry.Value))];

    private string _orientation = OrientationNames.Horizontal;
    private readonly List<ShipPlacementDto> _placed = [];
    private HashSet<CoordinatesDto> _takenCells = [];

    private ShipToPlaceDto? NextShip =>
        Session.View is { } view && _placed.Count < view.FleetToPlace.Count
            ? view.FleetToPlace[_placed.Count]
            : null;

    private CoordinatesDto? _hover;
    private HashSet<CoordinatesDto> _preview = [];
    private bool _previewFits;

    /// <summary>
    /// L'empreinte du navire courant sous le curseur. Elle répond à la seule
    /// question que le joueur se pose avant de cliquer — « est-ce que ça
    /// tient ? » — avec la même règle que <see cref="PlaceAt"/>, pour ne pas
    /// annoncer une pose que le clic refuserait.
    /// </summary>
    private string? PreviewClass(CoordinatesDto cell) => _preview.Contains(cell)
        ? _previewFits ? "cell-preview" : "cell-blocked"
        : null;

    private void Hover(CoordinatesDto cell)
    {
        _hover = cell;
        RecomputePreview();
    }

    private void ClearHover()
    {
        _hover = null;
        _preview = [];
    }

    private void Turn(string orientation)
    {
        _orientation = orientation;
        RecomputePreview();
        Audio.Play("tap");
    }

    private void RecomputePreview()
    {
        if (Session.View is not { } view || NextShip is not { } ship || _hover is not { } origin)
        {
            _preview = [];
            return;
        }

        var cells = CellsOf(origin.Column, origin.Row, ship.Size, _orientation);

        _previewFits = cells.All(cell => cell.Column < view.Columns && cell.Row < view.Rows)
            && !cells.Any(_takenCells.Contains);

        _preview = [.. cells.Where(cell => cell.Column < view.Columns && cell.Row < view.Rows)];
    }

    /// <summary>
    /// Refuse localement ce que le serveur refuserait, pour éviter un
    /// aller-retour par navire. Le serveur revalide la flotte entière : ce
    /// contrôle est un confort d'interface, pas la garantie.
    /// </summary>
    private void PlaceAt(CoordinatesDto origin)
    {
        if (Session.View is not { } view || NextShip is not { } ship)
        {
            return;
        }

        var cells = CellsOf(origin.Column, origin.Row, ship.Size, _orientation);

        if (cells.Any(cell => cell.Column >= view.Columns || cell.Row >= view.Rows) ||
            cells.Any(_takenCells.Contains))
        {
            return;
        }

        _placed.Add(new ShipPlacementDto(ship.Kind, origin.Column, origin.Row, _orientation));
        RecomputeTakenCells();
        RecomputePreview();
        Audio.Play("drop");
    }

    private static List<CoordinatesDto> CellsOf(int column, int row, int size, string orientation) =>
        [.. Enumerable.Range(0, size).Select(offset => orientation == OrientationNames.Horizontal
            ? new CoordinatesDto(column + offset, row)
            : new CoordinatesDto(column, row + offset))];

    private void RecomputeTakenCells() =>
        _takenCells = [.. _placed.SelectMany(ship => CellsOf(
            ship.Column,
            ship.Row,
            Session.View!.FleetToPlace.First(candidate => candidate.Kind == ship.Kind).Size,
            ship.Orientation))];

    private void UndoLastShip()
    {
        _placed.RemoveAt(_placed.Count - 1);
        RecomputeTakenCells();
        RecomputePreview();
        Audio.Play("bubble");
    }

    private void ClearFleet()
    {
        _placed.Clear();
        RecomputeTakenCells();
        _preview = [];
    }

    private async Task ConfirmFleetAsync() => await Session.PlaceFleetAsync(_placed);


    private Dictionary<CoordinatesDto, string> _fired = [];
    private HashSet<CoordinatesDto> _ownShipCells = [];
    private HashSet<CoordinatesDto> _ownHitCells = [];
    private HashSet<CoordinatesDto> _sunkCells = [];
    private HashSet<CoordinatesDto> _incoming = [];

    private readonly HashSet<CoordinatesDto> _justRevealed = [];
    private readonly HashSet<CoordinatesDto> _justStruck = [];
    private Guid _watchedGame;
    private string? _watchedViewer;
    private bool _watchedOver;

    /// <summary>Au-delà, le bot enchaîne et les voix se superposent en bouillie.</summary>
    private const int MaxVoices = 4;

    /// <summary>
    /// La session est Scoped : elle survit au composant, qui est reconstruit à
    /// chaque retour sur la page. S'abonner ne suffit donc pas — sans cette
    /// première projection, les grilles restent vides jusqu'au prochain
    /// changement de la session.
    /// </summary>
    protected override void OnInitialized()
    {
        Project();
        Session.OnChange += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Audio.PrimeAsync();
        }
    }

    public void Dispose() => Session.OnChange -= Refresh;

    private void Refresh()
    {
        Project();
        StateHasChanged();
    }

    private void Project()
    {
        var view = Session.View;

        if (view is null)
        {
            _fired = [];
            _ownShipCells = [];
            _ownHitCells = [];
            _sunkCells = [];
            _incoming = [];
            _justRevealed.Clear();
            _justStruck.Clear();
            _watchedGame = Guid.Empty;
            _watchedViewer = null;
            _watchedOver = false;
            return;
        }

        var seenShots = _fired;
        var seenDamage = _ownHitCells;
        var seenSplashes = _incoming;

        _fired = view.ShotsFired.ToDictionary(shot => shot.Target, shot => shot.Result);
        _ownShipCells = [.. view.OwnFleet.SelectMany(ship => ship.Cells)];
        _ownHitCells = [.. view.OwnFleet.SelectMany(ship => ship.Hits)];
        _sunkCells = [.. view.OwnFleet.Where(ship => ship.IsSunk).SelectMany(ship => ship.Cells)];
        _incoming = [.. view.ShotsReceived];

        _justRevealed.Clear();
        _justStruck.Clear();

        // En hot-seat la vue change de propriétaire : tout y est « nouveau »
        // sans qu'aucun tir n'ait eu lieu. Comparer deux vues qui n'ont ni la
        // même partie ni le même viewer rejouerait la partie entière en sons.
        var sameEyes = view.GameId == _watchedGame && view.ViewerName == _watchedViewer;
        var wasOver = _watchedOver;

        _watchedGame = view.GameId;
        _watchedViewer = view.ViewerName;
        _watchedOver = Session.IsOver;

        if (!sameEyes || Session.IsAwaitingHandover)
        {
            return;
        }

        foreach (var shot in view.ShotsFired)
        {
            if (!seenShots.ContainsKey(shot.Target))
            {
                _justRevealed.Add(shot.Target);
            }
        }

        foreach (var cell in _incoming.Where(cell => !seenSplashes.Contains(cell))
            .Concat(_ownHitCells.Where(cell => !seenDamage.Contains(cell))))
        {
            _justStruck.Add(cell);
        }

        Announce(view, wasOver);
    }

    /// <summary>
    /// Les tirs arrivent par paquets — un enchaînement du bot tient dans un
    /// seul rafraîchissement. Les voix sont donc étalées dans le temps, dans
    /// l'ordre du journal, pour qu'on entende une salve et non un accord.
    /// </summary>
    private void Announce(GameViewResponse view, bool wasOver)
    {
        var delay = 0.0;
        var voices = 0;

        foreach (var shot in view.ShotsFired.Where(shot => _justRevealed.Contains(shot.Target)))
        {
            if (voices++ >= MaxVoices)
            {
                break;
            }

            Audio.Play(VoiceOf(shot.Result), delay);
            delay += 0.3;
        }

        foreach (var cell in _justStruck)
        {
            if (voices++ >= MaxVoices)
            {
                break;
            }

            Audio.Play(IncomingVoice(cell), delay);
            delay += 0.3;
        }

        if (Session.IsOver && !wasOver)
        {
            Audio.Play(view.Winner == view.ViewerName ? "win" : "lose", delay + 0.4);
        }
    }

    private static string VoiceOf(string result) => result switch
    {
        ShotResultNames.Hit => "hit",
        ShotResultNames.Sunk => "sunk",
        _ => "miss"
    };

    private string IncomingVoice(CoordinatesDto cell) =>
        _sunkCells.Contains(cell) ? "sunk"
        : _ownHitCells.Contains(cell) ? "hit"
        : "miss";

    private async Task StartAsync()
    {
        ClearFleet();
        Audio.Play("dive");
        await Session.StartAsync(_playerName, _side, _mode, _botDifficulty, _fleetPlacement,
            _mode == GameModeNames.Local ? _opponentName : null, FleetAsNames());
    }

    /// <summary>La flotte posee appartient au joueur precedent : l'ecran suivant repart de zero.</summary>
    private void ConfirmHandover()
    {
        ClearFleet();
        Audio.Play("bubble");
        Session.ConfirmHandover();
    }

    private async Task RetryHandoverAsync() => await Session.RetryHandoverAsync();

    private async Task FireAsync(CoordinatesDto target) => await Session.FireAsync(target.Column, target.Row);

    private async Task RetryBotTurnAsync() => await Session.RetryBotTurnAsync();

    private async Task DemonstrateGrpcRefusalAsync()
    {
        Audio.Play("tap");
        await Session.DemonstrateGrpcRefusalAsync();
    }

    private void Reset()
    {
        Session.Forget();
        ClearFleet();
        ClearHover();
        Project();
    }

    private static string Label(CoordinatesDto cell) => $"{(char)('A' + cell.Column)}{cell.Row + 1}";

    /// <summary>
    /// L'etat d'une case ne doit pas tenir a sa seule couleur : un lecteur
    /// d'ecran n'annoncait que « bouton A1 », et « bouton A1 desactive » aussi
    /// bien pour une case deja visee que pour un tour qui n'est pas le sien.
    /// Le libelle porte donc l'etat, en plus du repere visuel ajoute au CSS.
    /// </summary>
    private string EnemyCellLabel(CoordinatesDto cell, string? known) => known switch
    {
        ShotResultNames.Miss => $"{Label(cell)} — à l'eau",
        ShotResultNames.Hit => $"{Label(cell)} — touché",
        ShotResultNames.Sunk => $"{Label(cell)} — coulé",
        not null => $"{Label(cell)} — {known}",
        _ when !Session.CanFire => $"{Label(cell)} — non visée, ce n'est pas à vous de jouer",
        _ => $"{Label(cell)} — non visée"
    };

    private string OwnCellLabel(CoordinatesDto cell)
    {
        if (_sunkCells.Contains(cell)) return $"{Label(cell)} — votre navire, coulé";
        if (_ownHitCells.Contains(cell)) return $"{Label(cell)} — votre navire, touché";
        if (_ownShipCells.Contains(cell)) return $"{Label(cell)} — votre navire, intact";
        if (_incoming.Contains(cell)) return $"{Label(cell)} — tir adverse à l'eau";
        return $"{Label(cell)} — vide";
    }

    private string PlacementCellLabel(CoordinatesDto cell) =>
        _takenCells.Contains(cell)
            ? $"{Label(cell)} — occupée par un navire"
            : $"{Label(cell)} — libre";

    private static string EnemyCellClass(string? result) => result switch
    {
        ShotResultNames.Miss => "cell-miss",
        ShotResultNames.Hit => "cell-hit",
        ShotResultNames.Sunk => "cell-sunk",
        _ => "cell-unknown"
    };

    private string OwnCellClass(CoordinatesDto cell)
    {
        if (_sunkCells.Contains(cell)) return "cell-sunk";
        if (_ownHitCells.Contains(cell)) return "cell-hit";
        if (_ownShipCells.Contains(cell)) return "cell-ship";
        if (_incoming.Contains(cell)) return "cell-miss";
        return "cell-empty";
    }
}
