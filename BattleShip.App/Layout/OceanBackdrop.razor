<div class="ocean" aria-hidden="true">
    <div class="surface">
        <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
            <path d="M0 34 C 75 6 225 6 300 34 C 375 62 525 62 600 34 C 675 6 825 6 900 34 C 975 62 1125 62 1200 34 L1200 0 L0 0 Z" />
        </svg>
    </div>

    <div class="rays">
        @foreach (var ray in Rays)
        {
            <span style="--x: @(ray.X)%; --w: @(ray.Width)rem; --tilt: @(ray.Tilt)deg; --delay: @(ray.Delay)s"></span>
        }
    </div>

    <div class="caustics"></div>

    <div class="bubbles">
        @foreach (var bubble in Bubbles)
        {
            <span style="--x: @(bubble.X)%; --size: @(bubble.Size)px; --drift: @(bubble.Drift)px; --duration: @(bubble.Duration)s; --delay: @(bubble.Delay)s"></span>
        }
    </div>

    <div class="shoal">
        <svg class="fish fish-a" viewBox="0 0 120 60">
            <path class="tail" d="M92 30 L118 10 L112 30 L118 50 Z" />
            <ellipse class="body" cx="52" cy="30" rx="44" ry="24" />
            <path class="fin" d="M46 8 C 58 -6 74 0 70 12 Z" />
            <circle class="eye" cx="22" cy="24" r="6" />
            <circle class="pupil" cx="20" cy="25" r="3" />
            <path class="smile" d="M10 36 q 10 8 20 2" />
        </svg>

        <svg class="fish fish-b" viewBox="0 0 120 60">
            <path class="tail" d="M92 30 L118 10 L112 30 L118 50 Z" />
            <ellipse class="body" cx="52" cy="30" rx="44" ry="24" />
            <path class="fin" d="M46 8 C 58 -6 74 0 70 12 Z" />
            <circle class="eye" cx="22" cy="24" r="6" />
            <circle class="pupil" cx="20" cy="25" r="3" />
            <path class="smile" d="M10 36 q 10 8 20 2" />
        </svg>
    </div>

    <div class="seabed">
        <svg viewBox="0 0 1200 220" preserveAspectRatio="none">
            <g class="weeds">
                <path class="weed" style="--sway: 5s" d="M120 220 C 100 170 150 150 128 100 C 112 66 140 46 132 20" />
                <path class="weed" style="--sway: 6.5s" d="M170 220 C 152 180 190 160 176 118 C 164 84 186 66 180 44" />
                <path class="weed" style="--sway: 7.5s" d="M980 220 C 958 168 1010 148 986 96 C 968 58 998 40 990 14" />
                <path class="weed" style="--sway: 5.8s" d="M1032 220 C 1016 182 1052 162 1038 120 C 1026 86 1048 68 1042 46" />
                <path class="weed" style="--sway: 6.9s" d="M620 220 C 604 186 638 168 626 132 C 616 102 636 86 630 66" />
            </g>

            <path class="sand" d="M0 220 L0 150 C 90 112 190 168 300 140 C 420 110 470 162 600 148 C 730 134 790 104 900 132 C 1010 160 1110 116 1200 146 L1200 220 Z" />

            <g class="rocks">
                <ellipse cx="330" cy="176" rx="52" ry="30" />
                <ellipse cx="386" cy="188" rx="30" ry="18" />
                <ellipse cx="860" cy="182" rx="44" ry="26" />
            </g>
        </svg>
    </div>
</div>

@code {
    private sealed record Ray(int X, double Width, int Tilt, double Delay);

    private sealed record Bubble(int X, int Size, int Drift, double Duration, double Delay);

    private static readonly Ray[] Rays =
    [
        new(8, 7, -16, 0),
        new(26, 11, -9, 2.4),
        new(48, 6, 5, 4.8),
        new(67, 13, 12, 1.6),
        new(88, 8, 18, 3.6)
    ];

    private static readonly Bubble[] Bubbles =
    [
        new(6, 14, 40, 17, 0),
        new(13, 7, -25, 12, 3.5),
        new(21, 20, 60, 21, 6),
        new(29, 9, -35, 14, 1.2),
        new(37, 12, 30, 19, 8.5),
        new(45, 6, -18, 11, 4.4),
        new(54, 17, 48, 23, 2.1),
        new(62, 10, -40, 15, 9.8),
        new(70, 8, 22, 13, 5.7),
        new(78, 22, -55, 25, 0.8),
        new(86, 11, 34, 16, 7.3),
        new(94, 8, -28, 12, 11)
    ];
}
